DATABASE_URL=postgres://postgres@localhost:5432/familielogistikk
PORT=3000
# Valgfritt: slår på «les avtale fra bilde»
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Valgfritt: slår på stedssøk (Google Places API (New))
GOOGLE_MAPS_API_KEY=
# Din e-post: tilgang til /admin (bruksstatistikk). Flere skilles med komma
ADMIN_EMAILS=
# E-post for «Glemt passord» (resend.com). Uten nøkkel skrives lenken i serverloggen
RESEND_API_KEY=
MAIL_FROM=Familielogistikk <noreply@familielogistikk.no>
# Valgfritt: feillogging (sentry.io). Uten DSN logges feil bare i Render-loggen
SENTRY_DSN=
# Settes i render.yaml: produksjon / test. DB_SCHEMA=staging gir testmiljøet egne tabeller
APP_ENV=
DB_SCHEMA=
# Valgfritt: «Fortsett med Google». Redirect-URI i Google Cloud: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
